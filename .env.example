# Contraseña del panel de administración (/admin).
# Si no se define, se usa "bora-admin-2026". CÁMBIALA antes de publicar.
ADMIN_PASSWORD=

# Opcional. Secreto para firmar la cookie de sesión del panel.
# Si se deja vacío, la firma se deriva de ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# Opcional. Con clave, las descripciones las escribe Claude.
# Sin clave, las compone el redactor local incluido en el proyecto.
ANTHROPIC_API_KEY=
